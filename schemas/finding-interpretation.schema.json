{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grounded finding interpretation selection",
  "description": "No free prose. Semantic validator also requires supported evidence types, limitations, and exact measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "claims",
    "measurements"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "evidence_ids"
        ],
        "properties": {
          "code": {
            "enum": [
              "change_observed",
              "screening_interest",
              "dependent_methods",
              "alternatives_required",
              "reservoir_mechanism_unresolved",
              "recovery_not_established",
              "verify_repeatability",
              "obtain_independent_context",
              "weak_support",
              "conflicting_detectors"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "value"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      }
    }
  }
}
