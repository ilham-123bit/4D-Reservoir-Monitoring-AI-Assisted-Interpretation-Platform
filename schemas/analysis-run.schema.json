{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reservoir-time-machine.local/schemas/analysis-run.schema.json",
  "title": "Reservoir Time Machine analysis run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "dataset_manifest", "software", "configuration", "status", "outputs", "quality_gates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset_manifest": {"type": "string"},
    "software": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "git_revision": {"type": ["string", "null"]}, "environment_lock_hash": {"type": ["string", "null"]}}},
    "configuration": {"type": "object"},
    "status": {"enum": ["not_started", "blocked", "running", "complete", "failed"]},
    "quality_gates": {"type": "array", "items": {"type": "object", "required": ["gate", "status"], "properties": {"gate": {"type": "string"}, "status": {"enum": ["pass", "fail", "warning", "not_run"]}, "evidence": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["logical_name", "path", "format", "size_bytes", "sha256"], "properties": {"logical_name": {"type": "string"}, "path": {"type": "string"}, "format": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "units": {"type": ["string", "null"]}, "array_order": {"type": ["array", "null"], "items": {"type": "string"}}, "provenance": {"type": "object"}}, "additionalProperties": false}},
    "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
    "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
